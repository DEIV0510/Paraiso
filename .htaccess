# PARAISOS en cPanel (LiteSpeed). Reemplaza lo que hacía vercel.json.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Un solo dominio: https y sin www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://viajesparaisos.com%{REQUEST_URI} [L,R=301]

  # El Piqueteadero está oculto mientras se confirma su información
  RewriteRule ^el-piqueteadero(\.html)?$ / [L,R=302]
</IfModule>

# Archivos del servidor que no se publican
<FilesMatch "^(php\.ini|\.user\.ini|\.cpanel\.yml|\.git.*)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché: los HTML piden css/js con ?v=AAAAMMDD; subirlo en cada cambio
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|mp4|json)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
