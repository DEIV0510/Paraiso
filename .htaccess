# PARAISOS en cPanel (LiteSpeed): redirecciones, caché y seguridad del sitio.

DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Un solo dominio: https y sin www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://viajesparaisos.com%{REQUEST_URI} [L,R=301]

  # El Piqueteadero está oculto mientras se confirma su información
  RewriteRule ^el-piqueteadero(\.html)?$ / [L,R=302]
</IfModule>

# Archivos del servidor que no se publican
<FilesMatch "^(php\.ini|\.user\.ini|\.cpanel\.yml|\.git.*)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché: los HTML piden css/js con ?v=AAAAMMDD; subirlo en cada cambio
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|mp4|json)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Seguridad
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"
  # CSP: solo código propio, Three.js de cdnjs (con SRI) y los 2 scripts en
  # línea por hash. Si cambias un <script> en línea, recalcula su sha256
  # (ver README) o el navegador lo bloqueará.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com 'sha256-di+WdXUtwkMfYktv3iJTO+C/e1u3sJ5Ft7ynxoC6JXA=' 'sha256-GDxEIdl7YhT3N/ECF1wd2WRN4oJFdg4fnymjd4u/NHg='; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; connect-src 'self' https://gist.githubusercontent.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>
