{
  "redirects": [
    { "source": "/el-piqueteadero.html", "destination": "/", "permanent": false },
    { "source": "/el-piqueteadero", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/((?!fonts/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
